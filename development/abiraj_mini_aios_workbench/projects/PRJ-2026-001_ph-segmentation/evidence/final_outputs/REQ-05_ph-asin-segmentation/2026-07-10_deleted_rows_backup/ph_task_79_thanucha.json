\"\");\nsel.addEventListener(\"change\",()=>{const v=sel.value; cur=v===\"\"?null:+v; segFilter=null; movFilter=null; catFilter=null; sortKey=null; render();});\n\nfunction fmt(n){return (n==null?0:n).toLocaleString()}\nfunction f1(n){return (n==null?0:n).toFixed(1)}\nfunction segBadge(s){return `<span class=\"seg\" style=\"background:var(${SEGCOL[s]})\">${s}</span>`}\nfunction movBadge(m){const c=MOVCOL[m];const col=getComputedStyle(document.documentElement).getPropertyValue(c);\n  return `<span class=\"badge\" style=\"background:${col}22;color:${col}\">${m}</span>`}\nfunction delta(x){const cls=x>0?\"dpos\":x<0?\"dneg\":\"\";const s=x>0?\"+\"+fmt(x):fmt(x);return `<span class=\"${cls}\">${s}</span>`}\n\nfunction render(){\n  const esc=document.getElementById(\"escBar\");\n  if(cur===null){\n    document.getElementById(\"gTitle\").textContent=\"Select a Portfolio Holder\";\n    document.getElementById(\"gScope\").textContent=\"Pick a name to see that portfolio only — segments, movement and benchmarks in one view.\";\n    document.getElementById(\"cards\").innerHTML=\"\";\n    document.getElementById(\"meta\").innerHTML=\"\";\n    document.getElementById(\"segMix\").innerHTML=\"\";\n    document.getElementById(\"movMix\").innerHTML=\"\";\n    esc.style.display=\"none\";\n    catBody([]); asinBody([]); document.getElementById(\"foot\").textContent=\"\";\n    document.getElementById(\"asinHint\").textContent=\"\";\n    return;\n  }\n  const name=D.phs[cur];\n  const rows=D.rows.filter(r=>r[C.ph]===cur);\n  const cats=D.cats.filter(c=>c[0]===cur);\n  const listings=rows.length;\n  const asins=new Set(rows.map(r=>r[C.asin])).size;\n  const skus=new Set(rows.filter(r=>r[C.sku]).map(r=>r[C.sku])).size;\n  const ncat=new Set(rows.map(r=>r[C.cat])).size;\n  const segCount={},movCount={};\n  SEGORDER.forEach(s=>segCount[s]=0); MOVORDER.forEach(m=>movCount[m]=0);\n  rows.forEach(r=>{segCount[r[C.seg]]++;movCount[r[C.mov]]++});\n  const lllPct=listings?Math.round(1000*segCount.LLL/listings)/10:0;\n\n  document.getElementById(\"gTitle\").textContent=name;\n  const _alloc=(D.alloc&&D.alloc[name])||0;\n  const _notActive=_alloc>asins?_alloc-asins:0;\n  document.getElementById(\"gScope\").textContent=`${fmt(listings)} listings · ${fmt(asins)} ASINs active this window · ${fmt(_alloc)} allocated${_notActive>0?` (${fmt(_notActive)} not active)`:\"\"} · ${fmt(skus)} SKUs · ${ncat} categor${ncat===1?\"y\":\"ies\"} — this portfolio only.`;\n\n  // cards\n  document.getElementById(\"cards\").innerHTML=[\n    [\"Assigned listings\",fmt(listings),\"rows in scope\"],\n    [\"Distinct ASINs\",fmt(asins),\"\"],\n    [\"Distinct SKUs\",fmt(skus),\"\"],\n    [\"Categories\",fmt(ncat),\"\"],\n    [\"Champions (HHH)\",fmt(segCount.HHH),\"scale these\"],\n    [\"Dead Horses (LLL)\",fmt(segCount.LLL),lllPct+\"% of portfolio\"],\n    [\"Allocated\",fmt(_alloc),_notActive>0?`${fmt(_notActive)} not active this window`:\"all active\"]\n  ].map((c,ci)=>`<div class=\"card c${ci+1}\"><div class=\"cardIcon\"></div><div class=\"k\">${c[0]}</div><div class=\"v\">${c[1]}</div><div class=\"s\">${c[2]}</div></div>`).join(\"\");\n\n  // meta strip\n  document.getElementById(\"meta\").innerHTML=[\n    [\"Current window (this report)\",\"31 May – 27 Jun 2026 · last 4 complete weeks (UK Amazon FBM)\"],\n    [\"Benchmark\",\"Top-30 best-sellers / category · average conversion rate\"],\n    [\"Movement compares\",\"current vs previous 4 weeks: 3 May – 30 May 2026 → 31 May – 27 Jun 2026\"],\n    [\"Report period\",D.period],\n    [\"Generated\",D.generated]\n  ].map(m=>`<div><div class=\"k\">${m[0]}</div><div class=\"v\">${m[1]}</div></div>`).join(\"\");\n\n  // escalation banner (our §8 rules, this PH)\n  let e=\"\";\n  if(lllPct>30) e+=`<div>\\u26A0 <b>${lllPct}%</b> of this portfolio is in LLL (Dead Horses) \\u2014 portfolio restructure review (\\u00a78)</div>`;\n  if(movCount.DECLINED>5) e+=`<div>\\u26A0 <b>${movCount.DECLINED}</b> ASINs declined this cycle \\u2014 Bietrick + sub-leader review (\\u00a78)</div>`;\n  if(e){esc.className=\"esc\";esc.innerHTML=e;esc.style.display=\"flex\";}\n  else {esc.className=\"esc ok\";esc.innerHTML=\"\\u2713 No \\u00a78 escalation thresholds breached for this portfolio.\";esc.style.display=\"flex\";}\n\n  // mixes (filter chips)\n  document.getElementById(\"segMix\").innerHTML=SEGORDER.map(s=>\n    `<span class=\"chip ${segFilter===s?'on':''}\" data-seg=\"${s}\"><span style=\"color:var(${SEGCOL[s]})\">\\u25CF</span> ${s} <span class=\"n\">${segCount[s]}</span></span>`).join(\"\");\n  document.getElementById(\"movMix\").innerHTML=MOVORDER.map(m=>\n    `<span class=\"chip ${movFilter===m?'on':''}\" data-mov=\"${m}\">${m} <span class=\"n\">${movCount[m]}</span></span>`).join(\"\");\n  document.querySelectorAll(\"[data-seg]\").forEach(el=>el.onclick=()=>{segFilter=segFilter===el.dataset.seg?null:el.dataset.seg;render();});\n  document.querySelectorAll(\"[data-mov]\").forEach(el=>el.onclick=()=>{movFilter=movFilter===el.dataset.mov?null:el.dataset.mov;render();});\n\n  // category table\n  catHead();\n  catBody(cats);\n  document.querySelectorAll(\"[data-cat]\").forEach(el=>el.onclick=()=>{const c=el.getAttribute(\"data-cat\");catFilter=catFilter===c?null:c;render();});\n\n  // asin table\n  let ar=rows.slice();\n  if(catFilter) ar=ar.filter(r=>r[C.cat]===catFilter);\n  if(segFilter) ar=ar.filter(r=>r[C.seg]===segFilter);\n  if(movFilter) ar=ar.filter(r=>r[C.mov]===movFilter);\n  if(sortKey!=null){ar.sort((a,b)=>{\n    let x,y;\n    if(sortKey===\"dImp\"){x=a[C.i]-a[C.bi];y=b[C.i]-b[C.bi];}\n    else if(sortKey===\"dClk\"){x=a[C.k]-a[C.bk];y=b[C.k]-b[C.bk];}\n    else if(sortKey===\"avgc\"){x=avgConvOf(a);y=avgConvOf(b);}\n    else if(sortKey===\"dConv\"){x=a[C.v]-avgConvOf(a);y=b[C.v]-avgConvOf(b);}\n    else if(sortKey===\"status\"){x=statusOf(a);y=statusOf(b);}\n    else {x=a[sortKey];y=b[sortKey];}\n    if(typeof x===\"string\"){return sortDir*x.localeCompare(y)} return sortDir*((x||0)-(y||0))});}\n  asinHead();\n  asinBody(ar);\n  document.getElementById(\"asinHint\").textContent=`— ${fmt(ar.length)} shown${catFilter?` · category: ${catFilter} (click it again to clear)`:\"\"}${segFilter?` · segment ${segFilter}`:\"\"}${movFilter?` · ${movFilter}`:\"\"}`;\n  document.getElementById(\"foot\").textContent=`Source: analytics.ph_segment_report (read-only). Segments, movement and benchmarks are the production engine's output — this view only reorganises them per portfolio holder.`;\n}\n\n/* ---- category table ---- */\nfunction catHead(){\n  document.querySelector(\"#catTbl thead\").innerHTML=\n   `<tr><th>Category</th><th class=\"num\">Listings</th><th class=\"num\">Top-N used</th>\n    <th class=\"num\">Avg impressions</th><th class=\"num\">Avg clicks</th><th class=\"num\">Avg conversions</th><th class=\"num\">Benchmark CVR%</th><th>Status</th></tr>`;\n}\nfunction catBody(cats){\n  const tb=document.querySelector(\"#catTbl tbody\");\n  if(!cats.length){tb.innerHTML='<tr><td class=\"empty\" colspan=\"8\">No categories.</td></tr>';return;}\n  tb.innerHTML=cats.map(c=>`<tr class=\"catrow ${catFilter===c[1]?'on':''}\" data-cat=\"${String(c[1]).replace(/\"/g,'&quot;')}\" style=\"cursor:pointer\">\n     <td><span class=\"catcue\">${catFilter===c[1]?'▾':'▸'}</span> ${c[1]}${catFilter===c[1]?' <span class=\"catactive\">filtering ✓</span>':''}</td><td class=\"num\">${fmt(c[2])}</td><td class=\"num\">${c[3]}</td>\n     <td class=\"num\">${fmt(c[4])}</td><td class=\"num\">${f1(c[5])}</td><td class=\"num\">${f1(c[8])}</td><td class=\"num\">${f1(c[6])}%</td>\n     <td>${c[7]==='NEEDS_MANUAL'?'<span class=\"man\">NEEDS MANUAL</span>':c[7].replace('_',' ')}</td></tr>`).join(\"\");\n}\n\n/* ---- asin table ---- */\nconst ACOLS=[\n  [\"Rank\",C.rank,1],[\"Category\",C.cat,0],[\"Segment\",C.seg,0],[\"Movement\",C.mov,0],[\"ASIN\",C.asin,0],[\"SKU\",C.sku,0],[\"Account\",C.acc,0],\n  [\"Impr\",C.i,1],[\"Clicks\",C.k,1],[\"Conv\",C.v,1],[\"Row CVR%\",C.cvr,1],\n  [\"Avg impr\",C.bi,1],[\"Avg clk\",C.bk,1],[\"Avg conv\",\"avgc\",1],[\"Bench CVR%\",C.bcvr,1],\n  [\"\\u0394 Impr\",\"dImp\",1],[\"\\u0394 Clk\",\"dClk\",1],[\"\\u0394 Conv\",\"dConv\",1],[\"Status\",\"status\",0]\n];\nfunction asinHead(){\n  document.querySelector(\"#asinTbl thead\").innerHTML=\"<tr>\"+ACOLS.map((c,idx)=>{\n    const num=c[2]?\"num\":\"\";const ar=(String(sortKey)===String(c[1]))?(sortDir>0?\"\\u25B2\":\"\\u25BC\"):\"\\u21C5\";\n    return `<th class=\"${num}\" data-k=\"${c[1]}\">${c[0]}<span class=\"ar\">${ar}</span></th>`;}).join(\"\")+\"</tr>\";\n  document.querySelectorAll(\"#asinTbl thead th\").forEach(th=>th.onclick=()=>{\n    const k=th.dataset.k; if(k===\"dImp\"||k===\"dClk\"){/*sort by computed*/}\n    if(sortKey===k){sortDir*=-1}else{sortKey=k;sortDir=1} render();});\n}\nfunction asinBody(rows){\n  const tb=document.querySelector(\"#asinTbl tbody\");\n  if(!rows.length){tb.innerHTML='<tr><td class=\"empty\" colspan=\"19\">No ASINs match this filter.</td></tr>';return;}\n  const frag=rows.map(r=>{\n    const avgc=avgConvOf(r);\n    const dImp=r[C.i]-r[C.bi], dClk=r[C.k]-r[C.bk], dConv=r[C.v]-avgc;\n    const _st=statusOf(r);\n    const _rowcls=_st===\"NEEDS_REVIEW\"?\" row-review\":\"\";\n    return `<tr class=\"${_rowcls.trim()}\">\n      <td class=\"num\">${r[C.rank]}</td>\n      <td>${r[C.cat]}</td><td>${segBadge(r[C.seg])}</td><td>${movBadge(r[C.mov])}</td>\n      <td>${r[C.asin]}</td><td>${r[C.sku]||'<span class=\"man\">—</span>'}</td><td>${ACC[r[C.acc]]}</td>\n      <td class=\"num\">${fmt(r[C.i])}</td><td class=\"num\">${fmt(r[C.k])}</td><td class=\"num\">${fmt(r[C.v])}</td>\n      <td class=\"num\">${f1(r[C.cvr])}%</td>\n      <td class=\"num\">${fmt(r[C.bi])}</td><td class=\"num\">${f1(r[C.bk])}</td><td class=\"num\">${f1(avgc)}</td><td class=\"num\">${f1(r[C.bcvr])}%</td>\n      <td class=\"num\">${delta(dImp)}</td><td class=\"num\">${delta(Math.round(dClk))}</td><td class=\"num\">${delta(Math.round(dConv*10)/10)}</td>\n      <td>${statBadge(statusOf(r))}</td></tr>`;\n  }).join(\"\");\n  tb.innerHTML=frag;\n}\n// sort support for computed delta columns\nconst _origSort=render;\nrender();\n\n(function(){ var s=document.getElementById(\"phsel\"); if(s){ s.value=\"0\"; s.dispatchEvent(new Event(\"change\")); } })();\n</script>\n</body>\n</html>\n",
 "description": "Monthly PH ASIN segmentation report (UK Amazon FBM). Thanucha, 6 segments, category-wise benchmarks, movement vs previous 4-week window, escalation flags. Window: last 4 complete weeks (31 May–27 Jun 2026). Movement fixed to equal 4-week windows. Rebuilt 1 Jul 2026.",
