# Python bytecode - regenerated on every run, never an artefact
__pycache__/
*.pyc

# Excel lock files, if a workbook is open while the builder runs
~$*.xlsx

# Secrets - passwords NEVER enter git (see AUTOMATION_PLAYBOOK.md)
automation/dst_secrets.bat

# Run logs, status and the collapse-guard baseline - machine-local, regenerated
automation/*.log
automation/dst_status.txt
automation/dst_last_good.json
